    "test": "vitest run --run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "ums-sdk": "^1.0.0",
    "zod": "^3.24.0"
  },
